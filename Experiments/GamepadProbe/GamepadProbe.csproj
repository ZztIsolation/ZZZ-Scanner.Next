<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ZZZ.GamepadProbe</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.4.0</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeFrameworkVersion>8.0.32</RuntimeFrameworkVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="[1.21.256]" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="[1.23.1]" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Scanning/Gamepad/*.cs" Link="Shared/Gamepad/%(Filename)%(Extension)" />
    <Compile Include="../../Ocr/PaddleOcrRecognizer.cs" Link="Shared/PaddleOcrRecognizer.cs" />
    <Compile Include="../../Ocr/OcrResult.cs" Link="Shared/OcrResult.cs" />
    <Compile Include="../../Ocr/OcrRuntimeSmoke.cs" Link="Shared/OcrRuntimeSmoke.cs" />
    <Compile Include="../../Core/AppInfo.cs" Link="Shared/AppInfo.cs" />
    <Compile Include="../../Cleaning/*.cs" Link="Shared/Cleaning/%(Filename)%(Extension)" />
    <Compile Include="../../Core/AppPaths.cs" Link="Shared/AppPaths.cs" />
    <Compile Include="../../Core/JsonDefaults.cs" Link="Shared/JsonDefaults.cs" />
    <Compile Include="../../Scanning/DriveDiscExport.cs" Link="Shared/DriveDiscExport.cs" />
    <None Include="../../Data/drive_discs.json;../../Data/stat_rules.json;../../Data/scan_profiles.json" Link="Data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Resources/models/characterDict.txt;../../Resources/models/PP-OCRv5_mobile_rec_infer.onnx" Link="Resources/models/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Tests/Fixtures/ocr-equivalence.png.b64" Link="Validation/ocr-equivalence.png.b64" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
